{
  "name": "downframe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:fast": "tsc --noEmit",
    "check:task": "npm test && npm run build && node --experimental-strip-types scripts/check-dist.ts",
    "check:full": "npm run check:task && npm audit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
